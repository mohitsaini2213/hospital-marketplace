# Public config only — never put secrets in frontend env vars.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Optional: only needed if you swap the built-in OpenStreetMap/Leaflet picker
# for Google Maps. Leave blank to keep using Leaflet (no key required).
VITE_MAP_API_KEY=
